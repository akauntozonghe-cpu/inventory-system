generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                 String   @id @default(cuid())
  username           String   @unique
  displayName        String
  passwordHash       String
  role               UserRole @default(WORKER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocktakeSessions StocktakeSession[]
  adminActionLogs   AdminActionLog[] @relation("AdminActionExecutor")
  errorReports      ErrorReport[]    @relation("ErrorReporter")
}

model Item {
  id                  String   @id @default(cuid())
  managementCode      String?  @unique
  managementGroupCode String?
  janCode             String?
  name                String
  manufacturer        String?
  majorCategory       String?
  minorCategory       String?
  defaultUnit         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inventoryInstances InventoryInstance[]
}

model StorageLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories InventoryInstance[]
}

model InventoryInstance {
  id String @id @default(cuid())

  itemId String
  item   Item @relation(fields: [itemId], references: [id])

  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id])

  managementCode      String?
  managementGroupCode String?
  manufacturer        String?
  majorCategory       String?
  minorCategory       String?
  lotNo               String?
  expirationDate      String?
  unit                String?

  quantity       Int
  actualQuantity Int?

  allocationType AllocationType
  status         String

  stocktakeStatus String   @default("未棚卸")
  stocktakeAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories        InventoryHistory[]
  stocktakeRecords StocktakeRecord[]
  stocktakeTargets StocktakeTarget[]

  @@unique([itemId, storageLocationId, lotNo, expirationDate])
}

model InventoryHistory {
  id String @id @default(cuid())

  inventoryInstanceId String
  inventoryInstance   InventoryInstance @relation(fields: [inventoryInstanceId], references: [id])

  changeQuantity Int
  action         String

  createdAt DateTime @default(now())
}

model StocktakeSession {
  id String @id @default(cuid())

  title    String
  operator String? @default("管理者")

  operatorUserId String?
  operatorUser   AppUser? @relation(fields: [operatorUserId], references: [id])

  location String?
  memo     String?

  scopeType  StocktakeScope @default(ALL)
  scopeValue String?
  scopeLabel String?

  status StocktakeStatus @default(IN_PROGRESS)

  startedAt   DateTime @default(now())
  pausedAt    DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records StocktakeRecord[]
  targets StocktakeTarget[]

  @@index([operatorUserId, status])
}

model StocktakeTarget {
  id String @id @default(cuid())

  sessionId String
  session   StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  inventoryInstanceId String
  inventoryInstance   InventoryInstance @relation(fields: [inventoryInstanceId], references: [id])

  expectedQuantity Int

  createdAt DateTime @default(now())

  @@unique([sessionId, inventoryInstanceId])
}

model StocktakeRecord {
  id String @id @default(cuid())

  sessionId String
  session   StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  inventoryInstanceId String
  inventoryInstance   InventoryInstance @relation(fields: [inventoryInstanceId], references: [id])

  countedQuantity Int
  memo            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, inventoryInstanceId])
}

model ErrorReport {
  id String @id @default(cuid())

  code     String
  title    String
  message  String
  severity ErrorSeverity     @default(ERROR)
  status   ErrorReportStatus @default(OPEN)

  route     String?
  sessionId String?
  detail    Json?

  occurredAt DateTime @default(now())
  resolvedAt DateTime?

  recoveryStatus   RecoveryStatus @default(NOT_ATTEMPTED)
  recoveryAttempts Int            @default(0)
  recoveredAt      DateTime?
  recoveryNote     String?

  reporterUserId String?
  reporterUser   AppUser? @relation("ErrorReporter", fields: [reporterUserId], references: [id])

  adminActionLogs AdminActionLog[]

  @@index([status, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([code, occurredAt])
}

model AdminActionLog {
  id String @id @default(cuid())

  action String
  detail Json?
  route  String?

  createdAt DateTime @default(now())

  adminUserId String
  adminUser   AppUser @relation("AdminActionExecutor", fields: [adminUserId], references: [id])

  errorReportId String?
  errorReport   ErrorReport? @relation(fields: [errorReportId], references: [id])

  targetUserId    String?
  targetSessionId String?

  @@index([adminUserId, createdAt])
  @@index([errorReportId, createdAt])
  @@index([targetSessionId, createdAt])
}

enum AllocationType {
  home
  flea_market
  warehouse
}

enum StocktakeScope {
  ALL
  LOCATION
  MAJOR_CATEGORY
  MINOR_CATEGORY
}

enum StocktakeStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum UserRole {
  ADMIN
  WORKER
}

enum ErrorSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ErrorReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum RecoveryStatus {
  NOT_ATTEMPTED
  IN_PROGRESS
  RECOVERED
  FAILED
  ADMIN_REQUIRED
}