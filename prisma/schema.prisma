generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                 String   @id @default(cuid())
  username           String   @unique
  displayName        String
  passwordHash       String
  role               UserRole @default(WORKER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  featurePermissions FeaturePermission[] @default([STOCKTAKE, CATALOG, STOCKTAKE_HISTORY])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocktakeSessions        StocktakeSession[]
  adminActionLogs          AdminActionLog[]          @relation("AdminActionExecutor")
  errorReports             ErrorReport[]             @relation("ErrorReporter")
  itemRegistrationRequests ItemRegistrationRequest[] @relation("RegistrationRequester")
  inventoryEvents          InventoryEvent[]          @relation("InventoryEventActor")
  notifications            Notification[]            @relation("NotificationRecipient")
  systemCheckRuns          SystemCheckRun[]
}

model Item {
  id                  String   @id @default(cuid())
  managementCode      String?  @unique
  managementGroupCode String?
  janCode             String?
  systemBarcode       String?  @unique
  name                String
  manufacturer        String?
  majorCategory       String?
  minorCategory       String?
  defaultUnit         String?

  // 削除せず廃止状態へ移し、在庫・棚卸履歴を保護する
  isArchived          Boolean  @default(false)
  archivedAt          DateTime?
  archiveReason       String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inventoryInstances  InventoryInstance[]

  @@index([isArchived, name])
  @@index([isArchived, majorCategory])
}

model StorageLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories              InventoryInstance[]
  itemRegistrationRequests ItemRegistrationRequest[]
}

model SystemOperationSetting {
  id              String   @id @default("system")
  mode            String   @default("NORMAL")
  message         String?
  updatedByUserId String?
  autoCheckIntervalMinutes Int @default(360)
  updatedAt       DateTime @updatedAt
}

model InventoryInstance {
  id String @id @default(cuid())

  itemId String
  item   Item @relation(fields: [itemId], references: [id])

  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id])

  managementCode      String?
  managementGroupCode String?
  manufacturer        String?
  majorCategory       String?
  minorCategory       String?
  lotNo               String?
  expirationDate      String?
  unit                String?

  quantity       Int
  actualQuantity Int?

  allocationType AllocationType
  status         String

  stocktakeStatus String   @default("未棚卸")
  stocktakeAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories        InventoryHistory[]
  stocktakeRecords StocktakeRecord[]
  stocktakeTargets StocktakeTarget[]
  inventoryEvents  InventoryEvent[]
  marketplaceListings MarketplaceListing[]

  @@unique([itemId, storageLocationId, lotNo, expirationDate])
}

model MarketplaceListing {
  id String @id @default(cuid())
  inventoryInstanceId String
  inventoryInstance InventoryInstance @relation(fields: [inventoryInstanceId], references: [id], onDelete: Restrict)
  channel String @default("flea_market")
  externalListingId String?
  title String
  price Int
  listedQuantity Int @default(1)
  soldQuantity Int @default(0)
  fee Int?
  shippingCost Int?
  status MarketplaceListingStatus @default(DRAFT)
  notes String?
  listedAt DateTime?
  soldAt DateTime?
  createdByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, externalListingId])
  @@index([status, updatedAt])
  @@index([inventoryInstanceId, status])
}

model InventoryHistory {
  id String @id @default(cuid())

  inventoryInstanceId String
  inventoryInstance   InventoryInstance @relation(fields: [inventoryInstanceId], references: [id])

  changeQuantity Int
  action         String

  createdAt DateTime @default(now())
}

model StocktakeSession {
  id String @id @default(cuid())

  title    String
  operator String? @default("管理者")

  operatorUserId String?
  operatorUser   AppUser? @relation(fields: [operatorUserId], references: [id])

  location String?
  memo     String?

  scopeType  StocktakeScope @default(ALL)
  scopeValue String?
  scopeLabel String?

  status StocktakeStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  pausedAt    DateTime?
  completedAt DateTime?

  cancelledAt       DateTime?
  cancelledByUserId String?
  cancellationNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records                  StocktakeRecord[]
  targets                  StocktakeTarget[]
  itemRegistrationRequests ItemRegistrationRequest[]
  inventoryEvents          InventoryEvent[]
  notifications            Notification[]

  @@index([operatorUserId, status])
  @@index([cancelledByUserId])
}

model StocktakeTarget {
  id String @id @default(cuid())

  sessionId String
  session   StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  inventoryInstanceId String
  inventoryInstance   InventoryInstance @relation(fields: [inventoryInstanceId], references: [id])

  expectedQuantity Int

  createdAt DateTime @default(now())

  @@unique([sessionId, inventoryInstanceId])
}

model StocktakeRecord {
  id String @id @default(cuid())

  sessionId String
  session   StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  inventoryInstanceId String
  inventoryInstance   InventoryInstance @relation(fields: [inventoryInstanceId], references: [id])

  countedQuantity Int
  memo            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, inventoryInstanceId])
}

model ItemRegistrationRequest {
  id String @id @default(cuid())

  requestedByUserId String
  requestedBy       AppUser @relation("RegistrationRequester", fields: [requestedByUserId], references: [id])

  stocktakeSessionId String?
  stocktakeSession   StocktakeSession? @relation(fields: [stocktakeSessionId], references: [id], onDelete: SetNull)

  scannedCode String?

  name                String
  manufacturer        String?
  managementCode      String?
  managementGroupCode String?
  majorCategory       String?
  minorCategory       String?

  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)

  quantity       Int     @default(0)
  unit           String?
  lotNo          String?
  expirationDate String?
  memo           String?

  status RegistrationRequestStatus @default(PENDING)

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewMemo       String?

  createdItemId              String?
  createdInventoryInstanceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([stocktakeSessionId])
  @@index([storageLocationId])
}

model InventoryEvent {
  id String @id @default(cuid())

  inventoryInstanceId String
  inventoryInstance   InventoryInstance @relation(fields: [inventoryInstanceId], references: [id], onDelete: Restrict)

  eventType InventoryEventType

  quantityBefore Int
  quantityChange Int
  quantityAfter  Int

  reason String?
  memo   String?
  detail Json?

  performedByUserId String?
  performedBy       AppUser? @relation("InventoryEventActor", fields: [performedByUserId], references: [id], onDelete: SetNull)

  stocktakeSessionId String?
  stocktakeSession   StocktakeSession? @relation(fields: [stocktakeSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([inventoryInstanceId, createdAt])
  @@index([eventType, createdAt])
  @@index([stocktakeSessionId])
  @@index([performedByUserId, createdAt])
}

model Notification {
  id String @id @default(cuid())

  type     NotificationType
  audience NotificationAudience @default(ADMIN)

  title   String
  message String
  detail  Json?

  recipientUserId String?
  recipientUser   AppUser? @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  stocktakeSessionId String?
  stocktakeSession   StocktakeSession? @relation(fields: [stocktakeSessionId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([audience, readAt, createdAt])
  @@index([recipientUserId, readAt, createdAt])
  @@index([stocktakeSessionId])
}

model ErrorReport {
  id String @id @default(cuid())

  code     String
  title    String
  message  String
  severity ErrorSeverity     @default(ERROR)
  status   ErrorReportStatus @default(OPEN)

  route     String?
  sessionId String?
  detail    Json?

  occurredAt DateTime  @default(now())
  resolvedAt DateTime?

  recoveryStatus   RecoveryStatus @default(NOT_ATTEMPTED)
  recoveryAttempts Int            @default(0)
  recoveredAt      DateTime?
  recoveryNote     String?

  reporterUserId String?
  reporterUser   AppUser? @relation("ErrorReporter", fields: [reporterUserId], references: [id])

  adminActionLogs AdminActionLog[]

  @@index([status, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([code, occurredAt])
}

model AdminActionLog {
  id String @id @default(cuid())

  action String
  detail Json?
  route  String?

  createdAt DateTime @default(now())

  adminUserId String
  adminUser   AppUser @relation("AdminActionExecutor", fields: [adminUserId], references: [id])

  errorReportId String?
  errorReport   ErrorReport? @relation(fields: [errorReportId], references: [id])

  targetUserId    String?
  targetSessionId String?

  @@index([adminUserId, createdAt])
  @@index([errorReportId, createdAt])
  @@index([targetSessionId, createdAt])
}

model SystemCheckRun {
  id String @id @default(cuid())

  mode    SystemCheckMode
  status  SystemCheckStatus
  summary String?

  executedByUserId String
  executedBy       AppUser @relation(fields: [executedByUserId], references: [id], onDelete: Restrict)

  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items SystemCheckItem[]

  @@index([createdAt])
  @@index([executedByUserId, createdAt])
  @@index([status, createdAt])
}

model SystemCheckItem {
  id String @id @default(cuid())

  runId String
  run   SystemCheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  code      String
  title     String
  type      SystemCheckItemType
  status    SystemCheckItemStatus
  detail    String?
  expected  String?
  actual    String?
  errorCode String?

  checkedAt DateTime @default(now())

  @@index([runId, status])
}

enum AllocationType {
  home
  flea_market
  warehouse
}

enum MarketplaceListingStatus {
  DRAFT
  READY
  LISTED
  SOLD
  CANCELLED
}

enum StocktakeScope {
  ALL
  LOCATION
  MAJOR_CATEGORY
  MINOR_CATEGORY
}

enum StocktakeStatus {
  IN_PROGRESS
  PAUSED
  REVIEW
  CONFLICT
  COMPLETED
  CANCELLED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  WORKER
}

enum InventoryEventType {
  OPENING_BALANCE
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  STOCKTAKE
  ADJUSTMENT
  DISPOSAL
  RETURN
  IMPORT
}

enum NotificationType {
  STOCKTAKE_COMPLETED
  STOCKTAKE_CONFLICT
  STOCKTAKE_DIFFERENCE
  LOW_STOCK
  EXPIRY_ALERT
  REGISTRATION_REQUEST
  SYSTEM_ERROR
  MARKETPLACE_SOLD
}

enum NotificationAudience {
  ADMIN
  USER
}

enum ErrorSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ErrorReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum RecoveryStatus {
  NOT_ATTEMPTED
  IN_PROGRESS
  RECOVERED
  FAILED
  ADMIN_REQUIRED
}

enum SystemCheckMode {
  AUTO
  MANUAL
}

enum SystemCheckStatus {
  PASSED
  WARNING
  FAILED
}

enum SystemCheckItemType {
  AUTO
  MANUAL
}

enum SystemCheckItemStatus {
  PASS
  WARNING
  FAIL
  NOT_RUN
}

enum FeaturePermission {
  STOCKTAKE
  INVENTORY_SEARCH
  ITEM_VIEW
  STOCKTAKE_HISTORY
  ITEM_REGISTER
  CATALOG
}
